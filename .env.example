# Entorno
ENVIRONMENT=local
DEBUG=false

# Base de datos
# El puerto 5433 evita chocar con otros PostgreSQL locales en 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/credigest

# Zona horaria
TZ=America/Mexico_City

# Seguridad
# Obligatorio en produccion. Debe tener al menos 32 bytes (RFC 7518 3.2).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32-bytes-minimo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
